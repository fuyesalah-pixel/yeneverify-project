# ============================================================
# YENE VERIFY — BACKEND ENVIRONMENT
#
# Copy to backend/.env for local development. Never commit the
# resulting file. Values below are examples only.
#
# Sensitivity legend:
#   [public]  — safe to expose and log
#   [config]  — deployment configuration, not a secret
#   [secret]  — never log, commit, or send to a client
#
# Metadata on each key is intentionally human-readable:
#   type | required | default (if any) | example/description
#
# Adding a variable? Update all of these in the same change:
#   1. this file
#   2. backend/src/config/env.schema.ts
#   3. docker/docker-compose.dev.yml when local wiring needs it
#   4. Hostinger/GitHub Actions injection when it is a secret
#   5. docs/ops/environment.md (run ./scripts/gen-env-docs.sh)
# ============================================================

# ---- Runtime ----
# [config] type=enum | required=false | default=development | Application environment; controls mock mode and boot guards (development | staging | production).
NODE_ENV=development

# [config] type=number | required=false | default=3000 | HTTP port used by the NestJS server.
PORT=3000

# [config] type=string | required=false | default=0.0.0.0 | Bind address; 0.0.0.0 is required inside a container.
HOST=0.0.0.0

# [config] type=string | required=false | default=Africa/Addis_Ababa | Server timezone.
TZ=Africa/Addis_Ababa

# [config] type=enum | required=false | default=info | Pino log level (trace | debug | info | warn | error).
LOG_LEVEL=debug

# [public] type=string | required=false | default=api | Public API path prefix.
API_PREFIX=api

# [public] type=string | required=false | default=v1 | Public API version.
API_VERSION=v1

# ---- App ----
# [public] type=string | required=false | default=Yene Verify | Product name used in metadata and email subjects.
APP_NAME=Yene Verify

# [config] type=url | required=false | default=http://localhost:3000 | Public application URL.
APP_URL=http://localhost:3000

# [public] type=string | required=false | default=Africa/Addis_Ababa | IANA timezone used for display formatting.
APP_TIMEZONE=Africa/Addis_Ababa

# [public] type=string | required=false | default=ETB | ISO 4217 currency code; ETB for the MVP.
APP_CURRENCY=ETB

# ---- Database ----
# [secret] type=url | required=true | example=postgresql://yene:yene_dev_password@localhost:5432/yene_verify?schema=public | PostgreSQL connection URL including credentials.
DATABASE_URL=postgresql://yene:yene_dev_password@localhost:5432/yene_verify?schema=public

# [secret] type=url | required=false | default=empty | Prisma shadow database URL used only by local/CI `migrate dev`; never used by the running API.
SHADOW_DATABASE_URL=postgresql://yene:yene_dev_password@localhost:5432/yene_verify_shadow?schema=public

# [config] type=number | required=false | default=2 | Minimum Prisma connection-pool size.
DATABASE_POOL_MIN=2

# [config] type=number | required=false | default=20 | Maximum Prisma connection-pool size.
DATABASE_POOL_MAX=20

# [config] type=number | required=false | default=15000 | Statement timeout in milliseconds.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---- Redis ----
# [secret] type=url | required=true | example=redis://localhost:6379 | Redis connection URL; use redis:// or rediss://.
REDIS_URL=redis://localhost:6379

# [config] type=string | required=false | default=yene: | Prefix for keys when Redis is shared.
REDIS_PREFIX=yene:

# ---- JWT ----
# [secret] type=string | required=true | example=change_me_access_secret_minimum_64_characters_xxxxxxxxxxxxxxxxxxxxxxxx | Access-token signing secret; minimum 64 characters; rotate every 90 days.
JWT_ACCESS_SECRET=change_me_access_secret_minimum_64_characters_xxxxxxxxxxxxxxxxxxxxxxxx

# [config] type=duration | required=false | default=15m | Access-token lifetime (zeit/ms style).
JWT_ACCESS_TTL=15m

# [secret] type=string | required=true | example=change_me_refresh_secret_minimum_64_characters_yyyyyyyyyyyyyyyyyyyyyyyy | Refresh-token signing secret; minimum 64 characters; must differ from the access secret.
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_64_characters_yyyyyyyyyyyyyyyyyyyyyyyy

# [config] type=duration | required=false | default=30d | Refresh-token lifetime (zeit/ms style).
JWT_REFRESH_TTL=30d

# [public] type=string | required=false | default=yene-verify | JWT issuer claim.
JWT_ISSUER=yene-verify

# [public] type=string | required=false | default=yene-verify-mobile | JWT audience claim.
JWT_AUDIENCE=yene-verify-mobile

# [secret] type=string | required=false | default=empty | Previous access key kept live during a zero-downtime rotation; minimum 64 characters when set.
JWT_ACCESS_PREVIOUS_SECRET=

# [secret] type=string | required=false | default=empty | Previous refresh key kept live during a zero-downtime rotation; minimum 64 characters when set.
JWT_REFRESH_PREVIOUS_SECRET=

# [public] type=string | required=false | default=access-v1 | Non-secret key identifier written in the JWT kid header.
JWT_ACCESS_KID=access-v1

# [public] type=string | required=false | default=refresh-v1 | Non-secret key identifier written in the JWT kid header.
JWT_REFRESH_KID=refresh-v1

# [public] type=string | required=false | default=empty | Previous access key identifier used while rotating keys.
JWT_ACCESS_PREVIOUS_KID=

# [public] type=string | required=false | default=empty | Previous refresh key identifier used while rotating keys.
JWT_REFRESH_PREVIOUS_KID=

# ---- OTP ----
# [config] type=number | required=false | default=6 | Number of digits in an OTP.
OTP_LENGTH=6

# [config] type=number | required=false | default=300 | OTP validity window in seconds.
OTP_TTL_SECONDS=300

# [config] type=number | required=false | default=5 | Maximum incorrect OTP attempts before lockout.
OTP_MAX_ATTEMPTS=5

# [config] type=number | required=false | default=900 | Lockout duration in seconds after the attempt limit.
OTP_LOCKOUT_SECONDS=900

# [config] type=number | required=false | default=10 | Bcrypt/OTP hashing rounds.
OTP_HASH_ROUNDS=10

# ---- PIN & Biometric (Step 11) ----
# [config] type=number | required=false | default=10 | Bcrypt/PIN hashing rounds. Same as OTP_HASH_ROUNDS.
PIN_HASH_ROUNDS=10

# [config] type=number | required=false | default=4 | Minimum PIN length (4 or 6).
PIN_MIN_LENGTH=4

# [config] type=number | required=false | default=6 | Maximum PIN length (4 or 6).
PIN_MAX_LENGTH=6

# [config] type=number | required=false | default=5 | Maximum incorrect PIN attempts before lockout.
PIN_MAX_ATTEMPTS=5

# [config] type=number | required=false | default=900 | Lockout duration in seconds after the attempt limit.
PIN_LOCKOUT_SECONDS=900

# [config] type=number | required=false | default=10 | Maximum PIN verification attempts per 5 minutes.
PIN_RATE_ATTEMPTS_PER_5MIN=10

# [config] type=number | required=false | default=120 | Step-up token TTL in seconds (2 minutes).
STEP_UP_TOKEN_TTL_SECONDS=120

# [config] type=number | required=false | default=60 | Maximum unlock requests per hour per user.
UNLOCK_RATE_PER_HOUR=60

# ---- Phone ----
# [public] type=string | required=false | default=ET | Default ISO country code for phone normalization.
PHONE_DEFAULT_COUNTRY=ET

# [public] type=string | required=false | default=+251 | Default international phone prefix.
PHONE_DEFAULT_PREFIX=+251

# ---- AfroMessage ----
# [config] type=url | required=false | default=https://api.afromessage.com/api | AfroMessage REST base URL.
AFROMESSAGE_BASE_URL=https://api.afromessage.com/api

# [secret] type=string | required=staging/production | example=replace_me_afromessage_api_key | AfroMessage API key; local development uses the mock adapter.
AFROMESSAGE_API_KEY=replace_me_afromessage_api_key

# [config] type=string | required=false | default=YENEVRF | SMS sender ID.
AFROMESSAGE_SENDER_ID=YENEVRF

# [config] type=number | required=false | default=8000 | AfroMessage request timeout in milliseconds.
AFROMESSAGE_TIMEOUT_MS=8000

# [config] type=boolean | required=false | default=true | Use the deterministic local SMS mock; must be false in staging and production.
AFROMESSAGE_MOCK=true

# ---- Google Vision (OCR) ----
# [config] type=string | required=staging/production | example=replace_me_gcp_project_id | Google Cloud project ID used by the Vision adapter.
VISION_PROJECT_ID=replace_me_gcp_project_id

# [secret] type=path | required=false | default=/run/secrets/gcp-vision.json | Path to the read-only mounted GCP service-account JSON; never inline the JSON in production.
VISION_CREDENTIALS_JSON=/run/secrets/gcp-vision.json

# [config] type=number | required=false | default=15000 | Vision request timeout in milliseconds.
VISION_TIMEOUT_MS=15000

# [config] type=number | required=false | default=5242880 | Maximum image size in bytes (5 MiB).
VISION_MAX_IMAGE_BYTES=5242880

# [config] type=boolean | required=false | default=true | Use the deterministic local OCR mock; must be false in staging and production.
VISION_MOCK=true

# ---- Cloudflare R2 / local MinIO ----
# [secret] type=string | required=staging/production | example=replace_me_r2_account_id | Cloudflare R2 account identifier.
R2_ACCOUNT_ID=replace_me_r2_account_id

# [secret] type=string | required=staging/production | example=replace_me_r2_access_key_id | R2 access-key ID.
R2_ACCESS_KEY_ID=replace_me_r2_access_key_id

# [secret] type=string | required=staging/production | example=replace_me_r2_secret_access_key | R2 secret access key.
R2_SECRET_ACCESS_KEY=replace_me_r2_secret_access_key

# [config] type=string | required=false | default=yene-verify-receipts | Object-storage bucket for receipt images.
R2_BUCKET=yene-verify-receipts

# [config] type=string | required=false | default=auto | R2 region.
R2_REGION=auto

# [config] type=url | required=false | default=http://localhost:9000 | S3-compatible endpoint; use the R2 endpoint outside local MinIO mode.
R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com

# [config] type=url | required=false | default=http://localhost:9000 | Public/CDN base URL for non-secret asset links.
R2_PUBLIC_BASE_URL=https://cdn.yeneverify.com

# [config] type=number | required=false | default=300 | Presigned-upload lifetime in seconds.
R2_PRESIGN_TTL_SECONDS=300

# [config] type=number | required=false | default=8 | Maximum upload size in megabytes.
R2_MAX_UPLOAD_MB=8

# [config] type=boolean | required=false | default=true | Select local MinIO instead of Cloudflare R2; must be false in staging and production.
R2_USE_MINIO=true

# [config] type=url | required=false | default=empty | Local MinIO S3 endpoint.
MINIO_ENDPOINT=http://localhost:9000

# [secret] type=string | required=false | default=empty | Local-only MinIO access key; never reuse outside local development.
MINIO_ACCESS_KEY=yene_minio

# [secret] type=string | required=false | default=empty | Local-only MinIO secret key; never reuse outside local development.
MINIO_SECRET_KEY=replace_me_minio_secret

# ---- Firebase Cloud Messaging ----
# [config] type=string | required=staging/production | example=replace_me_firebase_project_id | Firebase project ID.
FCM_PROJECT_ID=replace_me_firebase_project_id

# [secret] type=email | required=staging/production | example=replace-me@example.invalid | Firebase Admin service-account email.
FCM_CLIENT_EMAIL=replace-me@example.invalid

# [secret] type=multiline-string | required=staging/production | example=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n | Firebase Admin private key; use escaped newlines in an environment panel.
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# [secret] type=path | required=false | default=empty | Optional read-only file containing the Firebase private key; takes precedence over FCM_PRIVATE_KEY when set.
FCM_PRIVATE_KEY_FILE=

# [config] type=boolean | required=false | default=true | Use the local FCM mock; must be false in staging and production.
FCM_MOCK=true

# ---- Email (transactional, future) ----
# [config] type=string | required=false | default=localhost | SMTP host.
SMTP_HOST=localhost

# [config] type=number | required=false | default=1025 | SMTP port.
SMTP_PORT=1025

# [secret] type=string | required=false | default=empty | SMTP username; empty for local MailHog.
SMTP_USER=

# [secret] type=string | required=false | default=empty | SMTP password; empty for local MailHog.
SMTP_PASS=

# [config] type=string | required=false | default=Yene Verify <no-reply@yeneverify.com> | From address for transactional email.
SMTP_FROM="Yene Verify <no-reply@yeneverify.com>"

# ---- Sentry (backend only) ----
# [secret] type=url | required=staging/production | default=empty | Server-side Sentry DSN; never place it in a mobile build.
SENTRY_DSN=

# [config] type=enum | required=false | default=development | Sentry environment tag (development | staging | production).
SENTRY_ENVIRONMENT=development

# [config] type=number | required=false | default=0.1 | Fraction of transactions sampled for performance monitoring.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Rate limiting ----
# [config] type=number | required=false | default=60 | General rate-limit window in seconds.
THROTTLE_TTL=60

# [config] type=number | required=false | default=100 | General requests allowed per window.
THROTTLE_LIMIT=100

# [config] type=number | required=false | default=60 | OTP-specific rate-limit window in seconds.
THROTTLE_OTP_TTL=60

# [config] type=number | required=false | default=5 | OTP-specific requests allowed per window.
THROTTLE_OTP_LIMIT=5

# ---- CORS ----
# [config] type=csv-urls | required=false | default=http://localhost:3000 | Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---- Feature flags ----
# [config] type=boolean | required=false | default=true | Enable the manual-review queue.
FF_MANUAL_REVIEW_ENABLED=true

# [config] type=boolean | required=false | default=true | Enable billing verification.
FF_BILLING_VERIFICATION_ENABLED=true

# [config] type=boolean | required=false | default=false | Enable ML insights; the MVP uses rule-based insights.
FF_ML_INSIGHTS_ENABLED=false

# ---- Bank adapters ----
# [config] type=number | required=false | default=12000 | Default bank-adapter timeout in milliseconds.
BANK_ADAPTER_TIMEOUT_MS=12000

# [config] type=number | required=false | default=2 | Retry count for a bank-adapter call.
BANK_ADAPTER_RETRIES=2

# [config] type=number | required=false | default=2 | Headless-browser pool size.
BANK_ADAPTER_HEADLESS_POOL_SIZE=2

# [config] type=string | required=false | default=YeneVerify/1.0 (+https://yeneverify.com/bot) | User agent used by bank adapters.
BANK_SCRAPE_USER_AGENT="YeneVerify/1.0 (+https://yeneverify.com/bot)"

# [config] type=boolean | required=false | default=true | Use deterministic mock bank adapters; must be false in staging and production.
BANK_ADAPTER_MOCK=true

# [config] type=boolean | required=false | default=true | Render the JS-heavy Telebirr receipt page with a headless browser; false in bare test/dev environments.
TELEBIRR_HEADLESS_ENABLED=true

# [config] type=number | required=false | default=2 | Browser instances kept alive for JS-rendered bank pages.
BROWSER_POOL_SIZE=2

# [config] type=number | required=false | default=4 | Max concurrently open pages against JS-rendered bank pages.
TELEBIRR_MAX_CONCURRENT=4

# [config] type=csv-urls | required=false | default=empty | Dashen receipt endpoints tried in order; Dashen has changed domains, so retargeting is an env update, not a code deploy.
DASHEN_ENDPOINTS=

# [config] type=csv-urls | required=false | default=empty | Abyssinia receipt endpoints tried in order; the lookup needs reference + account suffix.
ABYSSINIA_ENDPOINTS=

# [config] type=boolean | required=false | default=true | Client-signal flag: Abyssinia needs the last 5 digits of the destination account before it can verify (surface to the app in 13E).
BANK_SUPPLEMENTARY_REQUIRED_ABYSSINIA=true

# ---- Sub-merchant invites ----
# [config] type=number | required=false | default=7 | Invite token lifetime in days.
INVITE_TOKEN_TTL_DAYS=7

# [config] type=number | required=false | default=5 | Maximum times an invite can be resent.
INVITE_MAX_RESENDS=5

# [config] type=string | required=false | default=YENEVRF | SMS sender ID used for invite messages.
INVITE_SMS_SENDER_ID=YENEVRF

# [config] type=number | required=false | default=1 | Maximum active sub-merchants allowed on the free plan.
FREE_PLAN_MAX_SUB_MERCHANTS=1

# ---- Queue ----
# [config] type=number | required=false | default=4 | Concurrent verification workers.
QUEUE_VERIFICATION_CONCURRENCY=4

# [config] type=number | required=false | default=8 | Concurrent notification workers.
QUEUE_NOTIFICATION_CONCURRENCY=8

# [config] type=number | required=false | default=2 | Concurrent export workers.
QUEUE_EXPORT_CONCURRENCY=2

# [config] type=number | required=false | default=3 | Maximum attempts for a queued job.
QUEUE_JOB_ATTEMPTS=3

# [config] type=number | required=false | default=2000 | Initial retry backoff in milliseconds.
QUEUE_BACKOFF_MS=2000

# ---- Storage drivers (receipt uploads) ----
# [config] type=string | required=true | default=local | Active storage driver: 'local' (dev-only disk driver) or 'r2' (Cloudflare R2 via S3 SDK). Hosted environments require 'r2'.
STORAGE_DRIVER=local

# [config] type=string | required=false | default=./.storage/receipts | Disk root used only when STORAGE_DRIVER=local. Dev artifact — never used in staging/production.
STORAGE_LOCAL_PATH=./.storage/receipts

# ---- OCR pipeline ----
# [config] type=string | required=true | default=mock | Active OCR engine: 'mock' (deterministic dev fixtures) or 'google-vision' (Google Cloud Vision). Hosted environments require 'google-vision'.
OCR_PROVIDER=mock

# ---- Admin bootstrap (development only) ----
# [config] type=phone | required=false | default=+251900000000 | Phone used by the development seed only; never use a real personal number.
ADMIN_BOOTSTRAP_PHONE=+251900000000

# [config] type=string | required=false | default=Fuad | Display name used by the development seed.
ADMIN_BOOTSTRAP_NAME="Fuad"

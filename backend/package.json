{
  "name": "yene-verify-backend",
  "version": "0.1.0",
  "description": "Yene Verify — NestJS API backend",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "openapi:build": "tsc -p tsconfig.scripts.json",
    "openapi:export": "npm run openapi:build && node dist-scripts/scripts/export-openapi.js",
    "openapi:check": "npm run openapi:export && git diff --exit-code ../shared/contracts/openapi.yaml",
    "export:error-codes": "ts-node -r tsconfig-paths/register src/scripts/export-error-codes.ts",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "seed:minimal": "cross-env SEED_PROFILE=minimal ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "seed:dev": "cross-env SEED_PROFILE=dev ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "seed:staging": "cross-env SEED_PROFILE=staging ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "seed:prod": "cross-env SEED_PROFILE=prod ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:reset": "npx prisma migrate reset --force",
    "db:reset:seed": "npx prisma migrate reset --force --skip-seed && npm run seed:dev",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^8.18.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.7",
    "cache-manager": "^7.2.9",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.23",
    "firebase-admin": "^12.3.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "keyv": "^5.6.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.18.0",
    "puppeteer-core": "^22.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.3.10",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "setupFiles": [
      "../test/setup-env.js"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "passWithNoTests": true,
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@nestjs/core": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "bcrypt": true,
    "msgpackr-extract": true,
    "prisma@5.22.0": true,
    "protobufjs": true
  }
}

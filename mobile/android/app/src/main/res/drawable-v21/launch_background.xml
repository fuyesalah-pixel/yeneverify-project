<?xml version="1.0" encoding="utf-8"?>
<!-- Yene Verify launch surface. The Flutter splash continues the same brand
     gradient without a visible hand-off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#17A34A"
                android:centerColor="#0F7F37"
                android:endColor="#0A5F2A" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>

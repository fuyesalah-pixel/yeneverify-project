# ============================================================
# Yene Verify — Docker Compose variables (local development)
#
# Copy to docker/.env. Docker Compose reads this file when invoked
# with --env-file docker/.env (bootstrap.sh does this automatically).
# These values are intentionally fake and local-only. Never reuse them
# in staging or production.
# ============================================================

# ---- PostgreSQL ----
# [config] Local database username.
POSTGRES_USER=yene
# [config] Obviously fake local-only database password.
POSTGRES_PASSWORD=yene_dev_password
# [config] Local database name.
POSTGRES_DB=yene_verify
# [config] Host port mapped to PostgreSQL.
POSTGRES_PORT=5432

# ---- Redis ----
# [config] Host port mapped to Redis.
REDIS_PORT=6379

# ---- MailHog ----
# [config] Host SMTP port.
MAILHOG_SMTP_PORT=1025
# [config] Host MailHog web UI port.
MAILHOG_WEB_PORT=8025

# ---- MinIO (local Cloudflare R2 substitute) ----
# [config] Local-only MinIO root username.
MINIO_ROOT_USER=yene_minio
# [config] Obviously fake local-only MinIO root password.
MINIO_ROOT_PASSWORD=yene_minio_dev
# [config] Host S3 API port.
MINIO_API_PORT=9000
# [config] Host MinIO console port.
MINIO_CONSOLE_PORT=9001
# [config] Local receipt bucket name.
MINIO_BUCKET=yene-verify-receipts
# [config] Local export bucket name.
MINIO_EXPORTS_BUCKET=yene-verify-exports

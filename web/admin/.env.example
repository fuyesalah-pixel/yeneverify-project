# ── Google Sign-In (public) ───────────────────────────────────────────────
# Web OAuth 2.0 client ID from the Firebase/Google Cloud project. Public by
# design; the backend verifies the ID token and enforces the ADMIN_EMAILS
# allowlist. Add the admin dashboard origin to the client's authorized
# JavaScript origins (e.g. https://verify-admin.togttrading.com).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1042108670897-mvf53pl5jnrqpe7kco0cl75bbgm9vfuh.apps.googleusercontent.com

# ── Backend API (server-side only) ────────────────────────────────────────
# Browser requests go through /api/admin/* route handlers, which forward to
# this URL. Never expose this as a NEXT_PUBLIC_ value for tokens.
BACKEND_API_URL=https://verify-api.togttrading.com/api/v1
